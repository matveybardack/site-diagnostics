/* Единый стиль приложения. Состояния задаются динамическими свойствами
   (certainty, state), которые выставляет theme.set_state(). */

QToolTip { padding: 4px; }

/* вкладки */
QTabBar::tab { padding: 8px 20px; }

/* форма */
QGroupBox { font-weight: bold; margin-top: 14px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
QGroupBox QCheckBox { font-weight: normal; padding: 3px 0; }

QLabel#warningLabel,
QLabel#conflictLabel { color: #d08a00; font-weight: bold; }

/* кнопки */
QPushButton { padding: 6px 16px; min-width: 90px; }

QPushButton#diagnoseButton {
    background-color: #1e6fd9;
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 7px 22px;
}
QPushButton#diagnoseButton:hover { background-color: #2a7de8; }
QPushButton#diagnoseButton:pressed { background-color: #1859b0; }
QPushButton#diagnoseButton:focus { border: 2px solid #9cc4ff; padding: 5px 20px; }
QPushButton#diagnoseButton:disabled { background-color: #8c98a8; color: #e8e8e8; }

/* результат */
QLabel#placeholderLabel { color: #8a8a8a; }

QLabel#categoryLabel { font-weight: bold; }
QLabel#categoryLabel[certainty="established"],
QLabel#headlineLabel[certainty="established"] { color: #2e9e57; }
QLabel#categoryLabel[certainty="probable"],
QLabel#headlineLabel[certainty="probable"] { color: #d08a00; }
QLabel#categoryLabel[certainty="insufficient"],
QLabel#headlineLabel[certainty="insufficient"],
QLabel#detailsLabel[certainty="insufficient"] { color: #8a8a8a; }

QLabel#saveStatusLabel[state="ok"] { color: #2e9e57; }
QLabel#saveStatusLabel[state="error"] { color: #d64545; font-weight: bold; }

QProgressBar { border: 1px solid #8a8a8a; border-radius: 3px; text-align: center; }
QProgressBar::chunk { background-color: #4a90d9; border-radius: 2px; }
QProgressBar:disabled::chunk { background-color: #9aa0a6; }

/* строка состояния */
QLabel#dbStatus[state="ok"] { color: #2e9e57; }
QLabel#dbStatus[state="down"] { color: #d64545; font-weight: bold; }
